# Copy the relevant entries to your Codex configuration when local MCP servers are desired.
# No secrets are stored in this file.

[mcp_servers.postgres]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-postgres", "postgresql://streamtube:streamtube@localhost/streamtube"]

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
